{
  "p_negative": "p_c1 + p_c2",
  "p_neutral": "p_c3",
  "p_positive": "p_c4 + p_c5",
  "threshold": 0.6,
  "signal_rules": [
    {
      "condition": "p_positive >= 0.60 and p_positive > p_negative",
      "signal": "DEC"
    },
    {
      "condition": "p_negative >= 0.60 and p_negative > p_positive",
      "signal": "INC"
    },
    {
      "condition": "otherwise",
      "signal": "NO_TRADE"
    }
  ]
}
