{
  "model": "B2B XGBoost 5/20 Classifier",
  "class_indexing": "p_c1 through p_c5 correspond to C1 through C5 in order.",
  "classes": {
    "C1": {
      "condition": "spread < -20",
      "direction": "INC",
      "probability_field": "p_c1"
    },
    "C2": {
      "condition": "-20 <= spread < -5",
      "direction": "INC",
      "probability_field": "p_c2"
    },
    "C3": {
      "condition": "-5 <= spread <= 5",
      "direction": "NO_TRADE",
      "probability_field": "p_c3"
    },
    "C4": {
      "condition": "5 < spread <= 20",
      "direction": "DEC",
      "probability_field": "p_c4"
    },
    "C5": {
      "condition": "spread > 20",
      "direction": "DEC",
      "probability_field": "p_c5"
    }
  }
}
