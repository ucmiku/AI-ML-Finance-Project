{
  "probability_threshold": 0.6,
  "probability_definitions": {
    "p_negative": "p_c1 + p_c2",
    "p_neutral": "p_c3",
    "p_positive": "p_c4 + p_c5"
  },
  "signal_rules": [
    {
      "condition": "p_positive >= 0.60 and p_positive > p_negative",
      "signal": "DEC",
      "numeric_signal": 1
    },
    {
      "condition": "p_negative >= 0.60 and p_negative > p_positive",
      "signal": "INC",
      "numeric_signal": -1
    },
    {
      "condition": "otherwise",
      "signal": "NO_TRADE",
      "numeric_signal": 0
    }
  ],
  "notes": "Current C1 benchmark signal is generated by B2B classification probabilities only. B2A spread is delivered for magnitude, explanation and future filtering research."
}
